    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <output expression="&quot;Bu dastur 2 ta sonnning yigindisini hisoblaydi:&quot;" newline="True"/>
            <declare name="a, b" type="Integer" array="False" size=""/>
            <output expression="&quot;1-sonni kiriting&quot;" newline="True"/>
            <input variable="a"/>
            <output expression="&quot;2-sonni kiriting&quot;" newline="True"/>
            <input variable="b"/>
            <declare name="s" type="Integer" array="False" size=""/>
            <assign variable="s" expression="a+b"/>
            <output expression="&quot;Ikkita sonning yigindisi=&quot;" newline="True"/>
            <output expression="s" newline="True"/>
            <declare name="q, w, e" type="Integer" array="False" size=""/>
            <output expression="&quot;Ikkita sonning kopaytmasi&quot;" newline="True"/>
            <assign variable="q" expression="a*b"/>
            <output expression="q" newline="True"/>
        </body>
    </function>
</flowgorithm>
